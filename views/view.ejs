<%- include('_header', { name, mode: 'view' }) %>
  <h1 class="page-name"><%= name %></h1>
  <div class="page-body">
    <%- html %>
  </div>
  <div class="copy-bar">
    <button type="button" id="copy-btn" class="btn">📋 텍스트 복사</button>
    <p class="side-hint" id="copy-status"></p>
  </div>

  <div class="glossary-bar">
    <button type="button" id="glossary-btn" class="btn">🏷️ 전문용어 페이지 만들기</button>
  </div>
  <div id="glossary-panel" class="glossary-panel" style="display:none">
    <p class="glossary-hint">체크된 단어에 대해 새 페이지를 만들고(AI가 짧은 설명을 채워넣습니다), 이 문서에서 링크로 연결합니다.</p>
    <div id="glossary-list" class="glossary-list"></div>
    <div class="glossary-actions">
      <button type="button" id="glossary-generate" class="btn primary">생성</button>
      <button type="button" id="glossary-cancel" class="btn">취소</button>
    </div>
    <p class="side-hint" id="glossary-status"></p>
  </div>

  <div class="video-bar">
    <div class="video-bar-buttons">
      <button type="button" id="make-video-btn" class="btn">🎬 유튜브 영상 만들기</button>
      <button type="button" id="make-shorts-btn" class="btn">📱 쇼츠 영상 만들기</button>
    </div>
    <p class="side-hint" id="video-status"></p>
  </div>

  <div class="corefunc-bar">
    <button type="button" id="core-function-btn" class="btn">🧩 핵심 함수 만들기</button>
    <p class="side-hint" id="core-function-status"></p>
  </div>

  <div class="translate-bar">
    <button type="button" id="translate-btn" class="btn">🌐 영상 제목·설명 번역</button>
    <p class="side-hint" id="translate-status"></p>
  </div>

  <div class="jobsearch-bar">
    <div class="jobsearch-bar-buttons">
      <button type="button" class="btn jobsearch-btn" data-period="month">💼 최근 1개월 채용정보 찾기</button>
      <button type="button" class="btn jobsearch-btn" data-period="week">💼 최근 1주일 채용정보 찾기</button>
    </div>
    <p class="side-hint" id="jobsearch-status"></p>
  </div>

  <div class="page-footer-nav">
    <a class="btn" id="up-btn" style="display:none"></a>
  </div>
  <script src="/static/nav.js"></script>
  <script src="/static/copytext.js"></script>
  <script src="/static/glossary.js"></script>
  <script src="/static/video.js"></script>
  <script src="/static/corefunc.js"></script>
  <script src="/static/translate.js"></script>
  <script src="/static/jobsearch.js"></script>
  <% if (html.includes('class="mermaid"')) { %>
    <script src="/static/vendor/mermaid.min.js"></script>
    <script>mermaid.initialize({ startOnLoad: true });</script>
  <% } %>
<%- include('_footer') %>
